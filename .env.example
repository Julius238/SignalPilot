# Database
DATABASE_URL=postgresql://signalpilot:signalpilot@localhost:5432/signalpilot
REDIS_URL=redis://localhost:6379

# External integrations
N8N_WEBHOOK_SIGNAL_URL=https://your-n8n-instance/webhook/signalpilot-alert
FINNHUB_API_KEY=your_finnhub_api_key
BINANCE_BASE_URL=https://api.binance.com

# Provider request protection and incremental imports
MARKET_DATA_REQUEST_DELAY_MS=500
PROVIDER_RETRY_MAX_ATTEMPTS=3
PROVIDER_RETRY_BASE_DELAY_MS=500
PROVIDER_RETRY_MAX_DELAY_MS=8000
CRYPTO_INCREMENTAL_CANDLE_LIMIT=300
EQUITY_INCREMENTAL_BOOTSTRAP_DAYS=7
FINNHUB_MAX_DATA_AGE_HOURS=96

# One-shot resumable history backfill (not run by the normal pipelines)
CANDLE_BACKFILL_MAX_ASSETS=100
CRYPTO_BACKFILL_LOOKBACK_DAYS=730
BINANCE_BACKFILL_PAGE_SIZE=1000
FINNHUB_BACKFILL_1H_DAYS=90
FINNHUB_BACKFILL_1D_DAYS=1825
FINNHUB_BACKFILL_1H_WINDOW_DAYS=30
FINNHUB_BACKFILL_1D_WINDOW_DAYS=365

# Bounded scheduled gap audit
CANDLE_GAP_AUDIT_ENABLED=false
CANDLE_GAP_AUDIT_CRON=15 3 * * *
CANDLE_GAP_MAX_REPAIRS_PER_RUN=25

# Dynamic market universe (safe rollout: disabled and dry-run)
ASSET_DISCOVERY_ENABLED=false
ASSET_DISCOVERY_DRY_RUN=true
ASSET_DISCOVERY_CRON=30 2 * * *
ASSET_DISCOVERY_POLICY_VERSION=discovery-v1.0.0
ASSET_DISCOVERY_MAX_CANDIDATES=45
ASSET_DISCOVERY_VERIFICATION_CANDLE_LIMIT=80
ASSET_DISCOVERY_ACTIVE_CRYPTO_LIMIT=12
ASSET_DISCOVERY_ACTIVE_EQUITY_LIMIT=15
ASSET_DISCOVERY_ACTIVE_ETF_LIMIT=8
ASSET_DISCOVERY_MIN_SCORE=62
# Normalized 0-100 gates; underlying notional thresholds are asset-class specific.
ASSET_DISCOVERY_MIN_DATA_QUALITY=70
ASSET_DISCOVERY_MIN_LIQUIDITY=60
ASSET_DISCOVERY_MIN_DAYS_ACTIVE=7
ASSET_DISCOVERY_REPLACEMENT_SCORE_DELTA=8
ASSET_DISCOVERY_MAX_ADDITIONS_PER_RUN=3
ASSET_DISCOVERY_MAX_REMOVALS_PER_RUN=3
ASSET_DISCOVERY_REMOVAL_COOLDOWN_DAYS=14
ASSET_DISCOVERY_MAX_PER_SECTOR=3
ASSET_DISCOVERY_MAX_CORRELATED_ASSETS=2
ASSET_DISCOVERY_CORRELATION_THRESHOLD=0.85
ASSET_DISCOVERY_ALLOW_LEVERAGED_ETFS=false
ASSET_DISCOVERY_ALLOW_STABLECOINS=false
ASSET_DISCOVERY_SUMMARY_ENABLED=true
# Optional JSON overrides per class, e.g. {"CRYPTO":{"liquidity":16}}
ASSET_DISCOVERY_SCORE_WEIGHTS_JSON=

# News quality (shared 0-100 relevance scale)
NEWS_LOOKBACK_DAYS=7
NEWS_MIN_RELEVANCE_SCORE=30

# Trading mode (no live trading)
ENABLE_LIVE_TRADING=false
PAPER_TRADING_ONLY=true

# Dashboard origin (used for CORS)
DASHBOARD_ORIGIN=http://localhost:3000

# Next.js public API URL
NEXT_PUBLIC_SIGNALPILOT_API_URL=http://localhost:3100
# Optional server-side API URL. Production Docker uses http://api:3100.
SIGNALPILOT_API_INTERNAL_URL=http://localhost:3100

# ─────────────────────────────────────────────
# Auth & Security
# ─────────────────────────────────────────────

# Admin credentials
# Generate password hash from a cleartext password:
# ADMIN_PASSWORD='choose-a-cleartext-password' pnpm auth:hash-password
# Put only the generated ADMIN_PASSWORD_HASH value here.
# Do not store ADMIN_PASSWORD in .env. ADMIN_PASSWORD_HASH is not the login password.
ADMIN_USERNAME=admin
# Keep the bcrypt hash in single quotes when this file is read by Docker Compose.
ADMIN_PASSWORD_HASH=''

# Session signing secret — generate with: openssl rand -hex 32
# AUTH_SESSION_SECRET is not the login password.
AUTH_SESSION_SECRET=

# Cookie config
AUTH_COOKIE_NAME=signalpilot_session
AUTH_COOKIE_SECURE=false        # Set true behind HTTPS
AUTH_SESSION_TTL_HOURS=12

# Enable/disable auth (set false for local dev without login)
API_AUTH_ENABLED=true
DASHBOARD_AUTH_ENABLED=true

# Local development only. Never enable in production.
# This adds a /login button that creates an admin session without the password flow.
DEV_LOGIN_ENABLED=true
DEV_LOGIN_USERNAME=dev-admin

# Rate limiting
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=5
