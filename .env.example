# Database
DATABASE_URL=postgresql://signalpilot:signalpilot@localhost:5432/signalpilot
REDIS_URL=redis://localhost:6379

# External integrations
N8N_WEBHOOK_SIGNAL_URL=https://your-n8n-instance/webhook/signalpilot-alert
FINNHUB_API_KEY=your_finnhub_api_key
BINANCE_BASE_URL=https://api.binance.com

# Provider request protection and incremental imports
MARKET_DATA_REQUEST_DELAY_MS=500
PROVIDER_RETRY_MAX_ATTEMPTS=3
PROVIDER_RETRY_BASE_DELAY_MS=500
PROVIDER_RETRY_MAX_DELAY_MS=8000
CRYPTO_INCREMENTAL_CANDLE_LIMIT=300
EQUITY_INCREMENTAL_BOOTSTRAP_DAYS=7
FINNHUB_MAX_DATA_AGE_HOURS=96

# One-shot resumable history backfill (not run by the normal pipelines)
CANDLE_BACKFILL_MAX_ASSETS=100
CRYPTO_BACKFILL_LOOKBACK_DAYS=730
BINANCE_BACKFILL_PAGE_SIZE=1000
FINNHUB_BACKFILL_1H_DAYS=90
FINNHUB_BACKFILL_1D_DAYS=1825
FINNHUB_BACKFILL_1H_WINDOW_DAYS=30
FINNHUB_BACKFILL_1D_WINDOW_DAYS=365

# Bounded scheduled gap audit
CANDLE_GAP_AUDIT_ENABLED=false
CANDLE_GAP_AUDIT_CRON=15 3 * * *
CANDLE_GAP_MAX_REPAIRS_PER_RUN=25

# Dynamic market universe (safe rollout: disabled and dry-run)
ASSET_DISCOVERY_ENABLED=false
ASSET_DISCOVERY_DRY_RUN=true
ASSET_DISCOVERY_CRON=30 2 * * *
ASSET_DISCOVERY_POLICY_VERSION=discovery-v1.0.0
ASSET_DISCOVERY_MAX_CANDIDATES=45
ASSET_DISCOVERY_VERIFICATION_CANDLE_LIMIT=80
ASSET_DISCOVERY_ACTIVE_CRYPTO_LIMIT=12
ASSET_DISCOVERY_ACTIVE_EQUITY_LIMIT=15
ASSET_DISCOVERY_ACTIVE_ETF_LIMIT=8
ASSET_DISCOVERY_MIN_SCORE=62
# Normalized 0-100 gates; underlying notional thresholds are asset-class specific.
ASSET_DISCOVERY_MIN_DATA_QUALITY=70
ASSET_DISCOVERY_MIN_LIQUIDITY=60
ASSET_DISCOVERY_MIN_DAYS_ACTIVE=7
ASSET_DISCOVERY_REPLACEMENT_SCORE_DELTA=8
ASSET_DISCOVERY_MAX_ADDITIONS_PER_RUN=3
ASSET_DISCOVERY_MAX_REMOVALS_PER_RUN=3
ASSET_DISCOVERY_REMOVAL_COOLDOWN_DAYS=14
ASSET_DISCOVERY_MAX_PER_SECTOR=3
ASSET_DISCOVERY_MAX_CORRELATED_ASSETS=2
ASSET_DISCOVERY_CORRELATION_THRESHOLD=0.85
ASSET_DISCOVERY_ALLOW_LEVERAGED_ETFS=false
ASSET_DISCOVERY_ALLOW_STABLECOINS=false
ASSET_DISCOVERY_SUMMARY_ENABLED=true
# Optional JSON overrides per class, e.g. {"CRYPTO":{"liquidity":16}}
ASSET_DISCOVERY_SCORE_WEIGHTS_JSON=

# News quality (shared 0-100 relevance scale)
NEWS_LOOKBACK_DAYS=7
NEWS_MIN_RELEVANCE_SCORE=30

# Trading mode (no live trading)
ENABLE_LIVE_TRADING=false
PAPER_TRADING_ONLY=true

# ─── Shadow Trading (docs/trading) ───────────────────────────────────────────
# Shadow trading is internal candle simulation only. There is no exchange
# adapter, no API key and no order path in this build (ADR 0001).
# Every flag below is fail-closed: unset or unknown means blocked, and all of
# them must be set together before the manual job does anything
# (docs/trading/02, "Feature-Flags und sichere Defaults"; ADR 0006).
#
# Allowed values: DISABLED | SHADOW. Anything else aborts the job.
TRADING_MODE=DISABLED
# Master flag for shadow trading jobs.
TRADING_SHADOW_ENABLED=false
# Per-strategy flag for CRYPTO_MTF_BREAKOUT_V1.
TRADING_STRATEGY_V1_ENABLED=false
# Risk assessment flag for the manual shadow risk job.
TRADING_RISK_V1_ENABLED=false
# One-off operations bootstrap (portfolio, limit set, execution profiles,
# stopped session). Creates disabled structures only and never activates them.
TRADING_BOOTSTRAP_ENABLED=false
# P4: shadow order creation and entry-fill simulation.
TRADING_SHADOW_EXECUTION_ENABLED=false
# P4: stop/take-profit/time-exit monitoring, independent of the execution
# flag above so risk-reducing exits can keep running while entries are off.
TRADING_SHADOW_POSITION_MONITOR_ENABLED=false
# P4: ledger reconciliation and the idempotent UTC day rollover.
TRADING_SHADOW_RECONCILIATION_ENABLED=false
# Immutable build identifier written into every candidate audit event.
# Falls back to GIT_COMMIT_SHA, then to "unversioned-local-build".
TRADING_CODE_VERSION=

# ─── Trading Worker Scheduler (docs/trading P5) ──────────────────────────────
# apps/trading-worker's own scheduler. Both layers below are additional to,
# not instead of, the shadow flags above — a scheduled job only runs when its
# P1-P4 flag AND its scheduler flag are both true (docs/trading P5,
# "Konfiguration"). Fail-closed: unset or unknown means blocked.
# Master switch: the worker process only starts its scheduler when this and
# TRADING_MODE=SHADOW, TRADING_SHADOW_ENABLED=true, ENABLE_LIVE_TRADING=false
# all hold. False is the safe default — the process still runs and stays
# healthy, it just never schedules anything.
TRADING_WORKER_ENABLED=false
# Whether the scheduler registers any cron job at all.
TRADING_SCHEDULER_ENABLED=false
TRADING_DAY_START_JOB_ENABLED=false
TRADING_CANDIDATE_JOB_ENABLED=false
TRADING_RISK_JOB_ENABLED=false
TRADING_ORDER_JOB_ENABLED=false
TRADING_FILL_JOB_ENABLED=false
TRADING_POSITION_MONITOR_JOB_ENABLED=false
TRADING_RECONCILIATION_JOB_ENABLED=false
# Stable lease owner identity; defaults to a hostname/pid-derived value if unset.
TRADING_WORKER_OWNER_ID=
# Liveness file path checked by the container healthcheck.
TRADING_WORKER_HEARTBEAT_FILE=/tmp/trading-worker-heartbeat

# ─── Trading API (docs/trading P6) ────────────────────────────────────────────
# apps/api's /trading/* route group. Fail-closed: unset or unknown means
# blocked. Read routes need only the first flag; write operations
# additionally need TRADING_MODE=SHADOW, TRADING_SHADOW_ENABLED=true and
# ENABLE_LIVE_TRADING=false (the same shadow-only base gate the worker uses).
TRADING_API_ENABLED=false
TRADING_API_OPERATIONS_ENABLED=false
# Per-route override for the stricter operations rate limit (requests/minute).
TRADING_API_OPERATIONS_RATE_LIMIT_MAX=20
# Double-submit CSRF cookie name for /trading/operations/* only.
TRADING_CSRF_COOKIE_NAME=signalpilot_trading_csrf

# ─── Shadow Short (getrennte Long-/Short-Strategien) ─────────────────────────
# Drei unabhängige Gates oben auf dem Shadow-Only-Basis-Gate. Alle fail-closed.
#
# Ein Shadow-Short ist eine SYNTHETISCHE, ungehebelte Simulation: kein Borrow,
# kein Funding, keine Liquidation, kein Margin (ADR 0012). Ein echter Short
# braucht eine Futures-/Margin-faehige Exchange-Capability, die dieser Build
# nicht ausdruecken kann.
#
# Short laeuft nur, wenn ALLE gleichzeitig gelten:
#   TRADING_MODE=SHADOW
#   TRADING_SHADOW_ENABLED=true
#   TRADING_SHADOW_SHORT_ENABLED=true
#   TRADING_STRATEGY_SHORT_V1_ENABLED=true
#   ENABLE_LIVE_TRADING=false
TRADING_STRATEGY_LONG_V1_ENABLED=false
TRADING_STRATEGY_SHORT_V1_ENABLED=false
TRADING_SHADOW_SHORT_ENABLED=false

# ─── Trading Performance, Alerts und Retention (docs/trading P8) ──────────────
# Four independent flags on top of the shadow-only base gate. Every one is
# fail-closed: unset or an unknown value blocks, it never falls back to "on".
#
# Computing performance, recording an alert, delivering it and pruning
# technical rows are four separate risks, so they switch separately. In
# particular, TRADING_ALERT_OUTBOX_ENABLED=true with
# TRADING_ALERT_DELIVERY_ENABLED=false is the intended state while the alert
# catalogue is being validated: events are recorded, nothing is sent.
#
# Manual job:  pnpm trading-worker:shadow-performance-refresh
TRADING_PERFORMANCE_JOB_ENABLED=false
# Manual job:  pnpm trading-worker:shadow-alert-outbox
TRADING_ALERT_OUTBOX_ENABLED=false
# Delivery additionally requires TRADING_ALERT_OUTBOX_ENABLED=true.
TRADING_ALERT_DELIVERY_ENABLED=false
# Retention only ever touches BotRun, BotLog and TradingAlertOutboxAttempt.
# Even with this flag on, a run is a DRY RUN unless it is started with
# --apply:  pnpm trading-worker:shadow-retention -- --apply
TRADING_RETENTION_ENABLED=false

# ─── Trading Dashboard (docs/trading P7) ──────────────────────────────────────
# Dashboard-only, build-time flag (apps/dashboard). When false: no Shadow
# Trading navigation, no reachable /dashboard/trading/* pages, no /trading/*
# requests from the browser. Independent of the API-side TRADING_API_ENABLED
# flag above — both must be true for the dashboard to show live data.
NEXT_PUBLIC_TRADING_DASHBOARD_ENABLED=false

# Dashboard origin (used for CORS)
DASHBOARD_ORIGIN=http://localhost:3000

# Next.js public API URL
NEXT_PUBLIC_SIGNALPILOT_API_URL=http://localhost:3100
# Optional server-side API URL. Production Docker uses http://api:3100.
SIGNALPILOT_API_INTERNAL_URL=http://localhost:3100

# ─────────────────────────────────────────────
# Auth & Security
# ─────────────────────────────────────────────

# Admin credentials
# Generate password hash from a cleartext password:
# ADMIN_PASSWORD='choose-a-cleartext-password' pnpm auth:hash-password
# Put only the generated ADMIN_PASSWORD_HASH value here.
# Do not store ADMIN_PASSWORD in .env. ADMIN_PASSWORD_HASH is not the login password.
ADMIN_USERNAME=admin
# Keep the bcrypt hash in single quotes when this file is read by Docker Compose.
ADMIN_PASSWORD_HASH=''

# Session signing secret — generate with: openssl rand -hex 32
# AUTH_SESSION_SECRET is not the login password.
AUTH_SESSION_SECRET=

# Cookie config
AUTH_COOKIE_NAME=signalpilot_session
AUTH_COOKIE_SECURE=false        # Set true behind HTTPS
AUTH_SESSION_TTL_HOURS=12

# Enable/disable auth (set false for local dev without login)
API_AUTH_ENABLED=true
DASHBOARD_AUTH_ENABLED=true

# Local development only. Never enable in production.
# This adds a /login button that creates an admin session without the password flow.
DEV_LOGIN_ENABLED=true
DEV_LOGIN_USERNAME=dev-admin

# Rate limiting
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=5
