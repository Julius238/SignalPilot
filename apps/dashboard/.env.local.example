# Vorlage für die lokale Dashboard-Entwicklung.
#
#   cp apps/dashboard/.env.local.example apps/dashboard/.env.local
#
# Next.js liest die Root-`.env` dieses Monorepos NICHT — nur Dateien im
# App-Verzeichnis. Ohne diese Datei starten die Server-Komponenten mit einer
# relativen API-Adresse, und der Aufruf scheitert.
#
# Hier gehören keine Secrets hinein: Das Dashboard spricht ausschließlich mit
# der lokalen API und hält keine eigenen Zugangsdaten. API-Keys (Finnhub,
# Telegram) und die DATABASE_URL stehen in der Root-`.env` und werden von
# `apps/api` und `apps/worker` gelesen.

# Adresse, die der Browser verwendet. Muss vom Rechner des Nutzers erreichbar
# sein und wird in das Client-Bundle eingebacken (NEXT_PUBLIC_-Präfix).
NEXT_PUBLIC_SIGNALPILOT_API_URL=http://localhost:3100

# Adresse, die die Server-Komponenten (RSC) verwenden. Muss absolut sein:
# Node kann eine relative URL wie "/api" nicht auflösen. Fehlt der Wert, wirft
# `getApiUrl()` eine sprechende Fehlermeldung statt "Failed to parse URL".
# Im Docker-Betrieb steht hier der Servicename, z. B. http://api:3100
SIGNALPILOT_API_INTERNAL_URL=http://localhost:3100

# Auf `true` lassen, solange die API mit DASHBOARD_AUTH_ENABLED=true läuft —
# sonst zeigt das Dashboard einen Anmelde-Hinweis, den die API gar nicht verlangt.
DASHBOARD_AUTH_ENABLED=true

# Shadow-Trading-Oberfläche. Nicht setzen oder auf false lassen: Die Trading-
# Seiten bleiben dann ausgeblendet und es werden keine Trading-Endpunkte
# aufgerufen.
# NEXT_PUBLIC_TRADING_DASHBOARD_ENABLED=false
