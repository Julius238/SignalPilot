  CREATED
  VALIDATING
  READY_FOR_RISK
  APPROVED_FOR_SHADOW
  INVALID
  RISK_REJECTED
  EXPIRED
  CANCELLED
}

enum TradeEvidenceType {
  CANDLE
  SIGNAL
  MTF
  REGIME
  DATA_QUALITY
  RADAR
  NEWS
  EVENT
  DISCOVERY
  EXECUTION_PROFILE
}

enum TradeDecisionOutcome {
  APPROVE_SHADOW
  REJECT
  EXPIRE
  CANCEL
  ERROR
}

enum RiskAssessmentStatus {
  PASS
  FAIL
  ERROR
}

enum RiskRuleOutcome {
  PASS
  FAIL
  WARN
  ERROR
}

enum RiskSeverity {
  INFO
  WARNING
  BLOCKER
  CRITICAL
}

enum RiskLimitSetStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum RiskLimitScope {
  PORTFOLIO
}

enum RiskEventType {
  RISK_RULE_BLOCK
  DAILY_LOSS_LIMIT
  CONSECUTIVE_LOSS_LIMIT
  PORTFOLIO_INCONSISTENCY
  IDEMPOTENCY_OR_VERSION_CONFLICT
  CONFIGURATION_INVALID
  DATA_STALE
