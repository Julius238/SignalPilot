generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetType {
  STOCK
  ETF
  CRYPTO
}

enum SignalType {
  MOMENTUM_ALERT
  TREND_ALERT
  VOLUME_SPIKE
  VOLATILITY_SPIKE
  BREAKOUT_ALERT
  NEWS_REACTION
  EVENT_IMPACT
  NO_SIGNAL
}

enum SignalStatus {
  STRONG_WATCH
  WATCH
  WAIT
  AVOID
  NO_EDGE
}

enum SignalDirection {
  BULLISH
  BEARISH
  NEUTRAL
  MIXED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum WatchlistPriority {
  LOW
  MEDIUM
  HIGH
}

enum BotRunStatus {
  SUCCESS
  FAILED
  RUNNING
}

enum RadarEventType {
  MOVEMENT_SPIKE
  VOLUME_SPIKE
  VOLATILITY_SPIKE
  SCORE_CHANGE
  REGIME_CHANGE
  BREAKOUT_PROXIMITY
  SR_PROXIMITY
  MOMENTUM_SHIFT
  CONFLUENCE
}

enum RadarEventSeverity {
  INFO
  WATCH
  IMPORTANT
  CRITICAL
}

enum AlertChannel {
  TELEGRAM
  EMAIL
  DISCORD
  WEBHOOK
}

enum AlertStatus {
  PENDING
  SENT
  FAILED
}

enum PaperOrderSide {
  BUY
  SELL
}

enum PaperOrderStatus {
  PENDING
  FILLED
  CANCELLED
  REJECTED
}

enum PaperPositionStatus {
  OPEN
  CLOSED
}

enum PaperEvaluationStatus {
  OPEN
  EVALUATED
  EXPIRED
  SKIPPED
}

enum PaperEvaluationOutcome {
  POSITIVE
  NEGATIVE
  NEUTRAL
  INVALIDATED
  TARGET_REACHED
}

enum PaperEvaluationKind {
  DIRECTIONAL_BULLISH
  DIRECTIONAL_BEARISH
  RISK_WARNING
  OBSERVATION
  SKIPPED
}

enum PaperExpectedMoveDirection {
  UP
  DOWN
  ANY
  NONE
}

enum BacktestRunStatus {
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum BacktestOutcomeStatus {
  OPEN
  EVALUATED
  EXPIRED
  SKIPPED
}

enum BacktestOutcome {
  POSITIVE
  NEGATIVE
  NEUTRAL
  INVALIDATED
  TARGET_REACHED
}

enum StrategyComparisonStatus {
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum AssetUniverseRole {
  CORE
  DISCOVERY
  ACTIVE
  INACTIVE
}

enum AssetUniverseSource {
  CORE
  PINNED
  AUTO_DISCOVERED
  MANUAL
  EXCLUDED
  INACTIVE
}

enum AssetDiscoveryRunKind {
  UNIVERSE_REFRESH
  DISCOVERY_SCAN
  ACTIVE_SELECTION
  RECONCILIATION
  FULL_PIPELINE
}

enum AssetDiscoveryCandidateStatus {
  ELIGIBLE
  EXCLUDED
  SELECTED
  RETAINED
  REMOVED
  ERROR
}

enum AssetDiscoveryAction {
  ADD
  REMOVE
  KEEP
  NONE
}

model Asset {
  id                      String                    @id @default(cuid())
  symbol                  String
  name                    String
  assetType               AssetType
  exchange                String
  baseCurrency            String?
  quoteCurrency           String?
  currency                String?
  sector                  String?
  industry                String?
  provider                String?
  providerSymbol          String?
  providerMetadataJson    Json?
  instrumentStatus        String                    @default("ACTIVE")
  isTradable              Boolean                   @default(true)
  isLeveraged             Boolean                   @default(false)
  isInverse               Boolean                   @default(false)
  isStablecoin            Boolean                   @default(false)
  lastUniverseRefreshAt   DateTime?
  isActive                Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  candles                 Candle[]
  signals                 Signal[]
  paperOrders             PaperOrder[]
  positions               PaperPosition[]
  watchlistItem           WatchlistItem?
  newsItems               NewsItem[]
  events                  Event[]
  backtestSignals         BacktestSignal[]
  radarEvents             RadarEvent[]
  candleDataQuality       CandleDataQuality[]
  universeMemberships     AssetUniverseMembership[]
  universePreference      AssetUniversePreference?
  discoveryCandidates     AssetDiscoveryCandidate[]
  discoveryScoreSnapshots DiscoveryScoreSnapshot[]

  // Shadow trading back-relations (no column on Asset, see docs/trading/03)
  strategyAssignments StrategyAssignment[]
  executionProfiles   InstrumentExecutionProfile[]
  tradeCandidates     TradeCandidate[]
  shadowOrders        ShadowOrder[]
  shadowFills         ShadowFill[]
  shadowPositions     ShadowPosition[]

  @@unique([symbol, exchange, assetType])
  @@index([symbol])
  @@index([assetType, isActive])
  @@index([provider, providerSymbol])
  @@index([instrumentStatus, isTradable])
}

model AssetUniversePreference {
  id           String   @id @default(cuid())
  assetId      String   @unique
  isPinned     Boolean  @default(false)
  isExcluded   Boolean  @default(false)
  manualActive Boolean  @default(false)
  observeOnly  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([isPinned])
  @@index([isExcluded])
  @@index([manualActive])
}

model AssetUniverseMembership {
  id             String              @id @default(cuid())
  assetId        String
  role           AssetUniverseRole
  source         AssetUniverseSource
  isCurrent      Boolean             @default(true)
  reason         String
  policyVersion  String
  discoveryRunId String?
  activatedAt    DateTime?
  deactivatedAt  DateTime?
  validFrom      DateTime            @default(now())
  validTo        DateTime?
  cooldownUntil  DateTime?
  metadataJson   Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  asset          Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  discoveryRun   AssetDiscoveryRun?  @relation(fields: [discoveryRunId], references: [id], onDelete: SetNull)

  @@index([assetId, isCurrent])
  @@index([role, isCurrent])
  @@index([source, isCurrent])
  @@index([cooldownUntil])
  @@index([discoveryRunId])
}

model AssetDiscoveryRun {
  id                    String                    @id @default(cuid())
  runKey                String                    @unique
  kind                  AssetDiscoveryRunKind
  status                BotRunStatus
  enabled               Boolean                   @default(false)
  dryRun                Boolean                   @default(true)
  policyVersion         String
  checkedAssetCount     Int                       @default(0)
  excludedAssetCount    Int                       @default(0)
  candidateCount        Int                       @default(0)
  proposedAdditionCount Int                       @default(0)
  proposedRemovalCount  Int                       @default(0)
  activatedCount        Int                       @default(0)
  deactivatedCount      Int                       @default(0)
  providerRequestCount  Int                       @default(0)
  estimatedApiUnits     Int                       @default(0)
  errorCount            Int                       @default(0)
  exclusionReasonsJson  Json?
  metricsJson           Json?
  errorJson             Json?
  startedAt             DateTime                  @default(now())
  finishedAt            DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  candidates            AssetDiscoveryCandidate[]
  memberships           AssetUniverseMembership[]
  scoreSnapshots        DiscoveryScoreSnapshot[]

  @@index([kind, startedAt])
  @@index([status, startedAt])
  @@index([policyVersion])
}

model AssetDiscoveryCandidate {
  id                   String                        @id @default(cuid())
  discoveryRunId       String
  assetId              String
  status               AssetDiscoveryCandidateStatus
  proposedAction       AssetDiscoveryAction          @default(NONE)
  score                Float
  confidence           Float
  dataQuality          Float
  liquidity            Float
  rank                 Int?
  selected             Boolean                       @default(false)
  reasonsJson          Json
  exclusionReasonsJson Json
  metricsJson          Json?
  providerMetadataJson Json?
  subsequentReturn1d   Float?
  subsequentReturn7d   Float?
  subsequentReturn30d  Float?
  evaluatedAt          DateTime?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  discoveryRun         AssetDiscoveryRun             @relation(fields: [discoveryRunId], references: [id], onDelete: Cascade)
  asset                Asset                         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  scoreSnapshot        DiscoveryScoreSnapshot?

  @@unique([discoveryRunId, assetId])
  @@index([status, score])
  @@index([assetId, createdAt])
  @@index([proposedAction, createdAt])
}

model DiscoveryScoreSnapshot {
  id             String                  @id @default(cuid())
  discoveryRunId String
  candidateId    String                  @unique
  assetId        String
  score          Float
  rawScore       Float
  confidence     Float
  dataQuality    Float
  liquidity      Float
  sampleSize     Int
  policyVersion  String
  componentsJson Json
  weightsJson    Json
  metricsJson    Json?
  createdAt      DateTime                @default(now())
  discoveryRun   AssetDiscoveryRun       @relation(fields: [discoveryRunId], references: [id], onDelete: Cascade)
  candidate      AssetDiscoveryCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  asset          Asset                   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, createdAt])
  @@index([discoveryRunId, score])
  @@index([policyVersion])
}

model WatchlistItem {
  id           String            @id @default(cuid())
  assetId      String
  asset        Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  symbol       String
  priority     WatchlistPriority @default(MEDIUM)
  notes        String?
  alertEnabled Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([assetId])
  @@index([symbol])
  @@index([priority])
  @@index([alertEnabled])
}

model Candle {
  id        String   @id @default(cuid())
  assetId   String
  symbol    String
  timeframe String
  openTime  DateTime
  closeTime DateTime
  open      Decimal  @db.Decimal(30, 12)
  high      Decimal  @db.Decimal(30, 12)
  low       Decimal  @db.Decimal(30, 12)
  close     Decimal  @db.Decimal(30, 12)
  volume    Decimal  @db.Decimal(30, 12)
  source    String
  createdAt DateTime @default(now())
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // Shadow trading back-relations (no column on Candle, see docs/trading/03)
  anchoredTradeCandidates TradeCandidate[]      @relation("TradeCandidateAnchorCandle")
  shadowFills             ShadowFill[]          @relation("ShadowFillSourceCandle")
  shadowOrderCursors      ShadowOrder[]         @relation("ShadowOrderLastProcessedCandle")
  shadowPositionCursors   ShadowPosition[]      @relation("ShadowPositionLastProcessedCandle")
  shadowPositionEvents    ShadowPositionEvent[] @relation("ShadowPositionEventSourceCandle")
  tradingJobCursors       TradingJobCursor[]    @relation("TradingJobCursorLastCandle")

  @@unique([assetId, timeframe, openTime])
  @@index([symbol, timeframe, openTime])
  @@index([source])
}

model CandleDataQuality {
  id                    String    @id @default(cuid())
  assetId               String
  provider              String
  timeframe             String
  oldestCandle          DateTime?
  latestClosedCandle    DateTime?
  candleCount           Int       @default(0)
  expectedCandleCount   Int       @default(0)
  gapCount              Int       @default(0)
  missingCandleCount    Int       @default(0)
  latestDataAgeSeconds  Int?
  providerErrorCount    Int       @default(0)
  rateLimitCount        Int       @default(0)
  entitlementErrorCount Int       @default(0)
  noDataCount           Int       @default(0)
  lastSuccessfulFetchAt DateTime?
  lastAuditAt           DateTime?
  lastErrorKind         String?
  lastErrorAt           DateTime?
  backfillStart         DateTime?
  backfillEnd           DateTime?
  backfillCursor        DateTime?
  backfillStatus        String?
  metadataJson          Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  asset                 Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, provider, timeframe])
  @@index([provider, timeframe])
  @@index([lastAuditAt])
  @@index([lastErrorKind, lastErrorAt])
}

model Signal {
  id              String                 @id @default(cuid())
  assetId         String
  symbol          String
  timeframe       String
  signalType      SignalType
  status          SignalStatus
  direction       SignalDirection
  score           Float
  riskLevel       RiskLevel
  trendScore      Float
  momentumScore   Float
  volumeScore     Float
  volatilityScore Float
  rsiScore        Float
  newsScore       Float
  socialScore     Float
  eventScore      Float
  riskScore       Float
  createdAt       DateTime               @default(now())
  asset           Asset                  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  output          SignalOutput?
  alerts          Alert[]
  paperOrders     PaperOrder[]
  paperEvaluation PaperSignalEvaluation?
  ruleApplication SignalRuleApplication?

  // Shadow trading back-relation (no column on Signal, see docs/trading/03)
  tradeCandidates TradeCandidate[] @relation("TradeCandidateAnchorSignal")

  @@index([assetId, timeframe, createdAt])
  @@index([symbol, createdAt])
  @@index([signalType, status])
}

model SignalRuleApplication {
  id              String       @id @default(cuid())
  signalId        String       @unique
  signal          Signal       @relation(fields: [signalId], references: [id], onDelete: Cascade)
  originalScore   Float
  adjustedScore   Float
  originalStatus  SignalStatus
  adjustedStatus  SignalStatus
  finalRiskLevel  RiskLevel
  adjustmentsJson Json
  warningsJson    Json
  summary         String
  createdAt       DateTime     @default(now())

  @@index([adjustedStatus])
  @@index([createdAt])
}

model SignalOutput {
  id                     String   @id @default(cuid())
  signalId               String   @unique
  shortConclusion        String
  technicalJson          Json
  intelligenceJson       Json
  marketConfirmationJson Json
  counterArgument        String
  nextTrigger            String
  telegramText           String
  dashboardJson          Json
  createdAt              DateTime @default(now())
  signal                 Signal   @relation(fields: [signalId], references: [id], onDelete: Cascade)
}

model MarketRegimeSnapshot {
  id            String   @id @default(cuid())
  generatedAt   DateTime
  equityRegime  String
  cryptoRegime  String
  overallRegime String
  riskMode      String
  confidence    Float
  summary       String
  riskNote      String
  reportJson    Json
  createdAt     DateTime @default(now())

  @@index([generatedAt])
  @@index([overallRegime])
  @@index([riskMode])
}

model BacktestRun {
  id              String                   @id @default(cuid())
  name            String
  assetType       AssetType?
  symbols         Json?
  timeframes      Json
  from            DateTime
  to              DateTime
  status          BacktestRunStatus
  configJson      Json
  summaryJson     Json?
  startedAt       DateTime                 @default(now())
  finishedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  signals         BacktestSignal[]
  strategyResults StrategyBacktestResult[]

  @@index([status])
  @@index([startedAt])
}

model StrategyConfig {
  id          String                   @id @default(cuid())
  name        String
  description String?
  isDefault   Boolean                  @default(false)
  configJson  Json
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  results     StrategyBacktestResult[]

  @@index([name])
}

model StrategyComparisonRun {
  id          String                   @id @default(cuid())
  name        String
  status      StrategyComparisonStatus
  from        DateTime
  to          DateTime
  symbols     Json?
  assetType   AssetType?
  timeframes  Json
  configJson  Json
  summaryJson Json?
  startedAt   DateTime                 @default(now())
  finishedAt  DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  results     StrategyBacktestResult[]

  @@index([status])
  @@index([startedAt])
}

model StrategyBacktestResult {
  id                 String                @id @default(cuid())
  comparisonRunId    String
  comparisonRun      StrategyComparisonRun @relation(fields: [comparisonRunId], references: [id], onDelete: Cascade)
  strategyConfigId   String
  strategyConfig     StrategyConfig        @relation(fields: [strategyConfigId], references: [id], onDelete: Cascade)
  backtestRunId      String?
  backtestRun        BacktestRun?          @relation(fields: [backtestRunId], references: [id], onDelete: SetNull)
  totalSignals       Int
  evaluatedCount     Int
  winRate            Float?
  avgReturnAfter1d   Float?
  targetReachedCount Int
  invalidatedCount   Int
  positiveCount      Int
  negativeCount      Int
  neutralCount       Int
  summaryJson        Json
  rank               Int?
  createdAt          DateTime              @default(now())

  @@index([comparisonRunId])
  @@index([strategyConfigId])
  @@index([rank])
}

model BacktestSignal {
  id                String                @id @default(cuid())
  backtestRunId     String
  backtestRun       BacktestRun           @relation(fields: [backtestRunId], references: [id], onDelete: Cascade)
  assetId           String
  asset             Asset                 @relation(fields: [assetId], references: [id], onDelete: Cascade)
  symbol            String
  assetType         AssetType
  timeframe         String
  signalTime        DateTime
  signalType        SignalType
  status            SignalStatus
  direction         SignalDirection
  riskLevel         RiskLevel
  score             Float
  originalScore     Float?
  adjustedScore     Float?
  entryPrice        Decimal               @db.Decimal(30, 12)
  targetPrice       Decimal?              @db.Decimal(30, 12)
  invalidationPrice Decimal?              @db.Decimal(30, 12)
  outcome           BacktestOutcome?
  outcomeStatus     BacktestOutcomeStatus @default(OPEN)
  evaluatedAt       DateTime?
  returnAfter1h     Float?
  returnAfter4h     Float?
  returnAfter1d     Float?
  returnAfter3d     Float?
  maxFavorableMove  Float?
  maxAdverseMove    Float?
  contextJson       Json?
  createdAt         DateTime              @default(now())

  @@index([backtestRunId])
  @@index([symbol])
  @@index([timeframe])
  @@index([signalTime])
  @@index([outcome])
  @@index([status])
  @@index([signalType])
}

model NewsItem {
  id                String   @id @default(cuid())
  assetId           String?
  symbol            String
  source            String
  headline          String
  summary           String?
  url               String?
  imageUrl          String?
  publishedAt       DateTime
  category          String?
  relatedSymbols    Json?
  sentiment         String?
  relevanceScore    Float?
  dedupeKey         String?
  transportProvider String   @default("UNKNOWN")
  dashboardOnly     Boolean  @default(false)
  rawJson           Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  asset             Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@unique([assetId, dedupeKey])
  @@index([assetId])
  @@index([symbol])
  @@index([source])
  @@index([publishedAt])
  @@index([transportProvider, publishedAt])
  @@index([relevanceScore, publishedAt])
}

model Event {
  id               String    @id @default(cuid())
  assetId          String?
  symbol           String?
  eventType        String
  title            String
  summary          String?
  description      String?
  source           String
  sourceUrl        String?
  publishedAt      DateTime?
  eventDate        DateTime?
  eventTime        String?
  fiscalQuarter    String?
  fiscalYear       Int?
  epsEstimate      Decimal?  @db.Decimal(20, 6)
  epsActual        Decimal?  @db.Decimal(20, 6)
  revenueEstimate  Decimal?  @db.Decimal(30, 6)
  revenueActual    Decimal?  @db.Decimal(30, 6)
  importance       String?
  credibilityScore Float?
  rawJson          Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  asset            Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([symbol])
  @@index([eventType])
  @@index([eventDate])
  @@index([assetId])
  @@index([eventType, publishedAt])
  @@index([source, publishedAt])
}

model BotRun {
  id           String       @id @default(cuid())
  jobName      String
  status       BotRunStatus
  startedAt    DateTime     @default(now())
  finishedAt   DateTime?
  metadataJson Json?

  @@index([jobName, startedAt])
  @@index([status])
}

model BotLog {
  id           String   @id @default(cuid())
  level        String
  service      String
  message      String
  metadataJson Json?
  createdAt    DateTime @default(now())

  @@index([service, createdAt])
  @@index([level])
}

model RadarEvent {
  id             String             @id @default(cuid())
  assetId        String?
  symbol         String
  assetType      AssetType
  eventType      RadarEventType
  severity       RadarEventSeverity
  timeframe      String
  score          Float?
  movePercent    Float?
  relativeVolume Float?
  rangePercent   Float?
  shortMessage   String
  metadataJson   Json?
  createdAt      DateTime           @default(now())
  asset          Asset?             @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([symbol, createdAt])
  @@index([assetType, createdAt])
  @@index([eventType, createdAt])
  @@index([severity, createdAt])
  @@index([createdAt])
}

model Alert {
  id          String       @id @default(cuid())
  signalId    String?
  channel     AlertChannel
  status      AlertStatus  @default(PENDING)
  payloadJson Json
  sentAt      DateTime?
  error       String?
  createdAt   DateTime     @default(now())
  signal      Signal?      @relation(fields: [signalId], references: [id], onDelete: SetNull)

  @@index([signalId])
  @@index([channel, status])
  @@index([createdAt])
}

model AlertState {
  id                 String          @id @default(cuid())
  symbol             String
  assetId            String
  timeframe          String
  signalType         SignalType
  status             SignalStatus
  direction          SignalDirection
  lastSignalId       String?
  lastAlertId        String?
  lastScore          Float
  lastRiskLevel      RiskLevel
  lastAlignment      String?
  lastAlignmentScore Float?
  lastSentAt         DateTime
  sendCount          Int             @default(1)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([assetId, timeframe, signalType, status])
  @@index([symbol])
  @@index([lastSentAt])
  @@index([status])
}

model PaperSignalEvaluation {
  id                    String                     @id @default(cuid())
  signalId              String                     @unique
  signal                Signal                     @relation(fields: [signalId], references: [id], onDelete: Cascade)
  assetId               String
  symbol                String
  timeframe             String
  direction             SignalDirection
  status                SignalStatus
  signalType            SignalType
  score                 Float
  riskLevel             RiskLevel
  entryPrice            Decimal                    @db.Decimal(30, 12)
  invalidationPrice     Decimal?                   @db.Decimal(30, 12)
  targetPrice           Decimal?                   @db.Decimal(30, 12)
  evaluationKind        PaperEvaluationKind        @default(SKIPPED)
  expectedMoveDirection PaperExpectedMoveDirection @default(NONE)
  evaluationStatus      PaperEvaluationStatus      @default(OPEN)
  skipReason            String?
  openedAt              DateTime                   @default(now())
  evaluatedAt           DateTime?
  priceAfter1h          Decimal?                   @db.Decimal(30, 12)
  priceAfter4h          Decimal?                   @db.Decimal(30, 12)
  priceAfter1d          Decimal?                   @db.Decimal(30, 12)
  priceAfter3d          Decimal?                   @db.Decimal(30, 12)
  returnAfter1h         Float?
  returnAfter4h         Float?
  returnAfter1d         Float?
  returnAfter3d         Float?
  maxFavorableMove      Float?
  maxAdverseMove        Float?
  outcome               PaperEvaluationOutcome?
  notes                 String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@index([symbol])
  @@index([timeframe])
  @@index([status])
  @@index([signalType])
  @@index([evaluationKind])
  @@index([evaluationStatus])
  @@index([openedAt])
}

model PaperAccount {
  id              String          @id @default(cuid())
  name            String
  startingBalance Decimal         @db.Decimal(30, 12)
  currentBalance  Decimal         @db.Decimal(30, 12)
  currency        String
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  orders          PaperOrder[]
  positions       PaperPosition[]

  @@index([isActive])
}

model PaperOrder {
  id             String           @id @default(cuid())
  paperAccountId String
  assetId        String
  signalId       String?
  side           PaperOrderSide
  quantity       Decimal          @db.Decimal(30, 12)
  price          Decimal          @db.Decimal(30, 12)
  status         PaperOrderStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  filledAt       DateTime?
  paperAccount   PaperAccount     @relation(fields: [paperAccountId], references: [id], onDelete: Cascade)
  asset          Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)
  signal         Signal?          @relation(fields: [signalId], references: [id], onDelete: SetNull)

  @@index([paperAccountId, createdAt])
  @@index([assetId])
  @@index([signalId])
  @@index([status])
}

model PaperPosition {
  id                String              @id @default(cuid())
  paperAccountId    String
  assetId           String
  quantity          Decimal             @db.Decimal(30, 12)
  averageEntryPrice Decimal             @db.Decimal(30, 12)
  status            PaperPositionStatus @default(OPEN)
  openedAt          DateTime            @default(now())
  closedAt          DateTime?
  paperAccount      PaperAccount        @relation(fields: [paperAccountId], references: [id], onDelete: Cascade)
  asset             Asset               @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([paperAccountId, status])
  @@index([assetId])
}

model AuditLog {
