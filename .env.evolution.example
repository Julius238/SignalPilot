# ─── SignalPilot Evolution Engine (docs/trading/20-evolution-engine.md) ──────
# Separate from .env.production: this file holds ONLY what the evolution
# worker needs. Copy to .env.evolution on the host (chmod 600, never commit).
# Every value containing "$" must be single-quoted or written as "$$".

# Research cycles run only when true; false keeps the container idle.
EVOLUTION_ENABLED=false
# UTC cron; default Monday 01:15 (away from the 03:00 backup).
EVOLUTION_SCHEDULE_CRON=15 1 * * 1

# Restricted role from scripts/ops/evolution-db-role.sql — never the owner role.
EVOLUTION_DATABASE_URL=postgresql://signalpilot_evolution:CHANGE_ME@postgres:5432/signalpilot?schema=public

# AI provider: mock (no key, no cost) or anthropic (needs ANTHROPIC_API_KEY).
EVOLUTION_AI_PROVIDER=mock
# Secret. Set only on the host; never in Git, never in a log.
ANTHROPIC_API_KEY=
EVOLUTION_AI_MODEL_ADVANCED=claude-opus-5-5
EVOLUTION_AI_MODEL_STANDARD=claude-haiku-5-5
EVOLUTION_AI_EFFORT_ADVANCED=medium
EVOLUTION_AI_EFFORT_STANDARD=low
EVOLUTION_AI_MAX_OUTPUT_TOKENS_ADVANCED=16000
EVOLUTION_AI_MAX_OUTPUT_TOKENS_STANDARD=4000
# Hard limits, USD. No automatic top-up: an exhausted month pauses the agent.
EVOLUTION_AI_MONTHLY_BUDGET_USD=20
EVOLUTION_AI_RUN_BUDGET_USD=1
EVOLUTION_AI_MAX_RETRIES=3
EVOLUTION_AI_TIMEOUT_MS=300000
EVOLUTION_AI_REFUSAL_FALLBACK=default
EVOLUTION_AI_REVIEW_ENABLED=true

EVOLUTION_HYPOTHESES_PER_RUN=4
EVOLUTION_BACKTEST_CONCURRENCY=1
EVOLUTION_BACKTEST_TIMEOUT_MS=1800000
EVOLUTION_HOLDOUT_ENABLED=true
# Pre-registered gate version deciding new candidates (v2 = v1 + successor rule).
EVOLUTION_GATES_VERSION=v2
EVOLUTION_CODE_VERSION=
# Must stay false: AI-generated strategy code has no sandbox in V1.
EVOLUTION_CODE_GENERATION_ENABLED=false
