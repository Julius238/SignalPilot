{
  "name": "signalpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-asset market intelligence platform for stocks, ETFs, and crypto.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build && pnpm -r --filter './apps/**' build",
    "dev": "pnpm --parallel --filter './apps/**' dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "alert:test-latest-signal": "pnpm --filter @signalpilot/alerts test:latest-signal",
    "db:migrate:deploy": "pnpm --filter @signalpilot/database exec prisma migrate deploy --schema=$PWD/packages/database/prisma/schema.prisma",
    "db:generate": "pnpm --filter @signalpilot/database exec prisma generate --schema=$PWD/packages/database/prisma/schema.prisma",
    "db:seed": "pnpm --filter @signalpilot/database exec tsx src/seed.ts",
    "db:studio": "pnpm --filter @signalpilot/database prisma:studio",
    "dashboard:dev": "pnpm --filter @signalpilot/dashboard dev",
    "worker:analyze-crypto-indicators": "pnpm --filter @signalpilot/worker analyze:crypto-indicators",
    "worker:analyze-crypto-signals": "pnpm --filter @signalpilot/worker analyze:crypto-signals",
    "worker:create-paper-evaluations": "pnpm --filter @signalpilot/worker create:paper-evaluations",
    "worker:evaluate-paper-signals": "pnpm --filter @signalpilot/worker evaluate:paper-signals",
    "worker:reclassify-paper-evaluations": "pnpm --filter @signalpilot/worker reclassify:paper-evaluations",
    "worker:backfill-paper-evaluations": "pnpm --filter @signalpilot/worker backfill:paper-evaluations",
    "worker:fetch-crypto-candles": "pnpm --filter @signalpilot/worker fetch:crypto-candles",
    "worker:quick-crypto-radar": "pnpm --filter @signalpilot/worker quick:crypto-radar",
    "worker:quick-equity-radar": "pnpm --filter @signalpilot/worker quick:equity-radar",
    "worker:radar-summary": "pnpm --filter @signalpilot/worker radar:summary",
    "worker:global-event-monitor": "pnpm --filter @signalpilot/worker monitor:global-events",
    "worker:fetch-equity-candles": "pnpm --filter @signalpilot/worker fetch:equity-candles",
    "worker:fetch-equity-news": "pnpm --filter @signalpilot/worker fetch:equity-news",
    "worker:fetch-equity-events": "pnpm --filter @signalpilot/worker fetch:equity-events",
    "worker:backfill-candles": "pnpm --filter @signalpilot/worker backfill:candles",
    "worker:audit-candle-gaps": "pnpm --filter @signalpilot/worker audit:candle-gaps",
    "worker:calculate-market-regime": "pnpm --filter @signalpilot/worker calculate:market-regime",
    "worker:run-backtest": "pnpm --filter @signalpilot/worker run:backtest",
    "worker:run-strategy-comparison": "pnpm --filter @signalpilot/worker run:strategy-comparison",
    "worker:analyze-equity-signals": "pnpm --filter @signalpilot/worker analyze:equity-signals",
    "worker:run-equity-pipeline": "pnpm --filter @signalpilot/worker run:equity-pipeline",
    "worker:run-crypto-pipeline": "pnpm --filter @signalpilot/worker run:crypto-pipeline",
    "worker:discovery-refresh": "pnpm --filter @signalpilot/worker discovery:refresh",
    "worker:discovery-scan": "pnpm --filter @signalpilot/worker discovery:scan",
    "worker:discovery-select": "pnpm --filter @signalpilot/worker discovery:select",
    "worker:discovery-reconcile": "pnpm --filter @signalpilot/worker discovery:reconcile",
    "worker:discovery-run": "pnpm --filter @signalpilot/worker discovery:run",
    "trading-worker:shadow-generate-candidates": "pnpm --filter @signalpilot/trading-worker shadow:generate-candidates",
    "trading-worker:shadow-assess-risk": "pnpm --filter @signalpilot/trading-worker shadow:assess-risk",
    "trading-worker:shadow-bootstrap": "pnpm --filter @signalpilot/trading-worker shadow:bootstrap",
    "trading-worker:shadow-create-orders": "pnpm --filter @signalpilot/trading-worker shadow:create-orders",
    "trading-worker:shadow-process-fills": "pnpm --filter @signalpilot/trading-worker shadow:process-fills",
    "trading-worker:shadow-monitor-positions": "pnpm --filter @signalpilot/trading-worker shadow:monitor-positions",
    "trading-worker:shadow-reconcile-portfolio": "pnpm --filter @signalpilot/trading-worker shadow:reconcile-portfolio",
    "trading-worker:shadow-start-trading-day": "pnpm --filter @signalpilot/trading-worker shadow:start-trading-day",
    "trading-worker:shadow-ops": "pnpm --filter @signalpilot/trading-worker shadow:ops",
    "trading-worker:shadow-performance-refresh": "pnpm --filter @signalpilot/trading-worker shadow:performance-refresh",
    "trading-worker:shadow-alert-outbox": "pnpm --filter @signalpilot/trading-worker shadow:alert-outbox",
    "trading-worker:shadow-retention": "pnpm --filter @signalpilot/trading-worker shadow:retention",
    "trading-worker:shadow-eligibility": "pnpm --filter @signalpilot/trading-worker shadow:eligibility",
    "trading-worker:scheduler": "pnpm --filter @signalpilot/trading-worker scheduler",
    "worker:scheduler": "pnpm --filter @signalpilot/worker scheduler",
    "prisma:generate": "pnpm db:generate",
    "auth:hash-password": "tsx apps/api/scripts/hash-password.ts",
    "auth:verify-password": "tsx apps/api/scripts/verify-password.ts",
    "ops:prod:build": "bash scripts/ops/prod-build.sh",
    "ops:prod:up": "bash scripts/ops/prod-up.sh",
    "ops:prod:down": "bash scripts/ops/prod-down.sh",
    "ops:prod:logs": "bash scripts/ops/prod-logs.sh",
    "ops:prod:ps": "docker compose -f docker-compose.prod.yml ps",
    "ops:prod:migrate": "bash scripts/ops/prod-migrate.sh",
    "ops:prod:migrate:docker": "bash scripts/ops/prod-migrate-docker.sh",
    "ops:prod:seed:docker": "bash scripts/ops/prod-seed-docker.sh",
    "ops:prod:run-worker:docker": "bash scripts/ops/prod-run-worker-docker.sh",
    "ops:prod:backup": "bash scripts/ops/backup-postgres.sh",
    "ops:prod:restore": "bash scripts/ops/restore-postgres.sh",
    "ops:prod:health": "bash scripts/ops/healthcheck.sh",
    "ops:prod:reset-db-volume": "bash scripts/ops/prod-reset-db-volume.sh",
    "ops:prod:prisma-smoke": "bash scripts/ops/prisma-smoke.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
