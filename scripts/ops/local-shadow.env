# Lokaler Shadow-Betrieb (scripts/ops/local-shadow.sh): nur nicht-geheime
# Schalter. Secrets (DATABASE_URL, N8N_WEBHOOK_SIGNAL_URL, …) bleiben in der
# Root-.env; dotenv überschreibt keine hier gesetzte Variable.
#
# Kein Echtgeldhandel: Live-Trading aus, Shadow-Modus, kein Short.

ENABLE_LIVE_TRADING=false
PAPER_TRADING_ONLY=true
TRADING_MODE=SHADOW
TRADING_WORKER_ENABLED=true
TRADING_SHADOW_ENABLED=true

# Strategie: Long-Richtung frei (welche Strategie läuft, entscheidet die
# aktivierte Zuweisung — lokal CRYPTO_TREND_CORE_LONG_V1/BTC in SHADOW_V1 und
# CRYPTO_REGIME_LONG_V1/BTC in SHADOW_CHALLENGER_V1).
TRADING_STRATEGY_V1_ENABLED=true
TRADING_STRATEGY_LONG_V1_ENABLED=true
TRADING_STRATEGY_SHORT_V1_ENABLED=false
TRADING_SHADOW_SHORT_ENABLED=false

TRADING_RISK_V1_ENABLED=true
TRADING_SHADOW_EXECUTION_ENABLED=true
TRADING_SHADOW_POSITION_MONITOR_ENABLED=true
TRADING_SHADOW_RECONCILIATION_ENABLED=true

# Scheduler und Jobs
TRADING_SCHEDULER_ENABLED=true
TRADING_DAY_START_JOB_ENABLED=true
TRADING_CANDIDATE_JOB_ENABLED=true
TRADING_RISK_JOB_ENABLED=true
TRADING_ORDER_JOB_ENABLED=true
TRADING_FILL_JOB_ENABLED=true
TRADING_POSITION_MONITOR_JOB_ENABLED=true
TRADING_RECONCILIATION_JOB_ENABLED=true
TRADING_PERFORMANCE_JOB_ENABLED=true
TRADING_PERFORMANCE_SCHEDULE_ENABLED=true

# Alerts: lokal nur aufzeichnen (Outbox), nicht zustellen. Der Mac ist seit
# 2026-10-14 LOCAL_SHAKEDOWN; zugestellt wird nur noch vom VPS, damit der
# n8n-Kanal eindeutig bleibt (ein schlafender Mac meldete sonst bei jedem
# Aufwachen veraltete Daten).
TRADING_ALERT_OUTBOX_ENABLED=true
TRADING_ALERT_DELIVERY_ENABLED=false
TRADING_ALERT_SCHEDULE_ENABLED=true

# Portfolio-Set des lokalen Systemtests (SHADOW_V1, SHADOW_CHALLENGER_V1).
TRADING_PORTFOLIO_SET=LOCAL_SHAKEDOWN

# SignalPilot Arena: stündliche Fitness-Bewertung (nur Empfehlungen, schreibt
# ausschließlich Arena-Tabellen) und die Arena-Operator-Kommandos.
TRADING_ARENA_ENABLED=true
TRADING_ARENA_SCHEDULE_ENABLED=true

# Betrieb: Bootstrap und Retention nur manuell.
TRADING_BOOTSTRAP_ENABLED=false
TRADING_RETENTION_ENABLED=false
TRADING_WORKER_HEARTBEAT_FILE=/tmp/signalpilot-trading-worker-heartbeat
