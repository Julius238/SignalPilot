# ─── SignalPilot Production Environment ──────────────────────────────────────
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production to version control.

# ─── Database ────────────────────────────────────────────────────────────────
# These three variables are used by the postgres Docker service to initialise
# the database on first start. They must match the credentials in DATABASE_URL.
#
# IMPORTANT: Change POSTGRES_PASSWORD before deploying anywhere real.
# For a local production-test the defaults below work out of the box.
POSTGRES_USER=signalpilot
POSTGRES_PASSWORD=signalpilot
POSTGRES_DB=signalpilot

# Full connection URL used by the API and Worker.
# Inside Docker Compose, the hostname MUST be "postgres" (the service name).
# For local dev outside Docker, use localhost:5432 instead.
DATABASE_URL=postgresql://signalpilot:signalpilot@postgres:5432/signalpilot

# ─── Redis ───────────────────────────────────────────────────────────────────
# Inside Docker Compose the hostname MUST be "redis" (the service name).
REDIS_URL=redis://redis:6379

# ─── App origin ──────────────────────────────────────────────────────────────
# Public URL where the dashboard is served (used for CORS on the API).
# Use the exact origin without a trailing slash.
# For a local test: http://localhost:3000
DASHBOARD_ORIGIN=http://localhost:3000

# Browser URL for the API. Keep this same-origin so login cookies work both for
# http://VPS_IP:3000 and later behind an HTTPS reverse proxy. This value is baked
# into the dashboard image at build time.
NEXT_PUBLIC_SIGNALPILOT_API_URL=/api

# Server-side and /api rewrite target inside the Docker Compose network.
SIGNALPILOT_API_INTERNAL_URL=http://api:3100

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate password hash from a cleartext password:
# ADMIN_PASSWORD='choose-a-cleartext-password' pnpm auth:hash-password
# Put only the generated ADMIN_PASSWORD_HASH value here.
# Do not store ADMIN_PASSWORD in .env. ADMIN_PASSWORD_HASH is not the login password.
ADMIN_USERNAME=admin
# Keep the bcrypt hash in single quotes so Docker Compose does not interpolate `$`.
ADMIN_PASSWORD_HASH=''

# Generate: openssl rand -hex 32
# AUTH_SESSION_SECRET is not the login password.
AUTH_SESSION_SECRET=

AUTH_COOKIE_NAME=signalpilot_session
# Set true when serving over HTTPS, false for local HTTP testing
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_HOURS=12
API_AUTH_ENABLED=true
DASHBOARD_AUTH_ENABLED=true
DEV_LOGIN_ENABLED=false

# Rate limiting
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=5

# ─── External APIs ───────────────────────────────────────────────────────────
FINNHUB_API_KEY=
BINANCE_BASE_URL=https://api.binance.com
N8N_WEBHOOK_SIGNAL_URL=

# Provider request protection and small incremental imports
MARKET_DATA_REQUEST_DELAY_MS=500
PROVIDER_RETRY_MAX_ATTEMPTS=3
PROVIDER_RETRY_BASE_DELAY_MS=500
PROVIDER_RETRY_MAX_DELAY_MS=8000
CRYPTO_INCREMENTAL_CANDLE_LIMIT=300
EQUITY_INCREMENTAL_BOOTSTRAP_DAYS=7
FINNHUB_MAX_DATA_AGE_HOURS=96

# Resumable one-shot history backfill. The regular scheduler never runs this job.
CANDLE_BACKFILL_MAX_ASSETS=100
CRYPTO_BACKFILL_LOOKBACK_DAYS=730
BINANCE_BACKFILL_PAGE_SIZE=1000
FINNHUB_BACKFILL_1H_DAYS=90
FINNHUB_BACKFILL_1D_DAYS=1825
FINNHUB_BACKFILL_1H_WINDOW_DAYS=30
FINNHUB_BACKFILL_1D_WINDOW_DAYS=365

# Shared news scoring
NEWS_LOOKBACK_DAYS=7
NEWS_MIN_RELEVANCE_SCORE=30

# ─── Trading Safety ──────────────────────────────────────────────────────────
# DO NOT change these — SignalPilot has no live trading capability.
ENABLE_LIVE_TRADING=false
PAPER_TRADING_ONLY=true

# ─── Feature Flags ───────────────────────────────────────────────────────────
ENABLE_MARKET_REGIME=true
ENABLE_EQUITY_NEWS=true
ENABLE_EQUITY_EVENTS=true
ENABLE_EQUITY_PIPELINE=false
ENABLE_EQUITY_ALERTS=false
ENABLE_PAPER_EVALUATION=true

# ─── Scheduling ──────────────────────────────────────────────────────────────
# Cron expressions (server timezone). Recommended VPS crypto cadence: every 15 minutes.
CRYPTO_PIPELINE_CRON=*/15 * * * *
EQUITY_PIPELINE_CRON=30 * * * *

# Daily bounded gap audit. Enable only after the initial backfill has completed.
CANDLE_GAP_AUDIT_ENABLED=false
CANDLE_GAP_AUDIT_CRON=15 3 * * *
CANDLE_GAP_MAX_REPAIRS_PER_RUN=25

# Set to true to run a pipeline pass immediately when the worker starts
WORKER_RUN_ON_START=false
RUN_EQUITY_PIPELINE_ON_START=false

# Lightweight Crypto Radar for more frequent observations without running the full pipeline.
# When QUICK_RADAR_ENABLED=true, the worker-scheduler container runs it on QUICK_RADAR_CRON —
# no host crontab entry needed.
QUICK_RADAR_ENABLED=false
QUICK_RADAR_CRON=*/5 * * * *
QUICK_RADAR_MIN_MOVE_PERCENT=2.5
QUICK_RADAR_MIN_RELATIVE_VOLUME=2
QUICK_RADAR_MIN_RANGE_PERCENT=3
QUICK_RADAR_MAX_ASSETS=10
QUICK_RADAR_TIMEFRAME=1h
QUICK_RADAR_ALERTS_ENABLED=false
QUICK_RADAR_ALERT_COOLDOWN_MINUTES=60
QUICK_RADAR_MIN_ALERT_SEVERITY=IMPORTANT
# Chart-Pattern-Erkennung (Ausbruchsbereiche, Momentum-Wechsel, S/R-Nähe, Konfluenz)
QUICK_RADAR_PATTERNS_ENABLED=true

# Equity/ETF-Radar: nutzt bereits importierte Kerzen aus der Datenbank (kein API-Call).
# Läuft im worker-scheduler auf EQUITY_RADAR_CRON, sinnvoll nach der Equity-Pipeline.
EQUITY_RADAR_ENABLED=false
EQUITY_RADAR_CRON=15 */4 * * *
EQUITY_RADAR_TIMEFRAME=1d
EQUITY_RADAR_MIN_MOVE_PERCENT=2
EQUITY_RADAR_MIN_RELATIVE_VOLUME=1.8
EQUITY_RADAR_MIN_RANGE_PERCENT=2.5
EQUITY_RADAR_MAX_ASSETS=15
# Kerzen älter als das gelten als veraltet und werden übersprungen (96h = Wochenende + Puffer)
EQUITY_RADAR_MAX_DATA_AGE_HOURS=96
EQUITY_RADAR_ALERTS_ENABLED=false
EQUITY_RADAR_ALERT_COOLDOWN_MINUTES=240
EQUITY_RADAR_MIN_ALERT_SEVERITY=IMPORTANT
EQUITY_RADAR_PATTERNS_ENABLED=true

# Compact Radar Summary / Daily Briefing.
# When RADAR_SUMMARY_ENABLED=true, the worker-scheduler container runs it on RADAR_SUMMARY_CRON.
# Für ein Daily Briefing morgens/abends: RADAR_SUMMARY_CRON=0 7,19 * * * und LOOKBACK=720.
# Die Summary enthält Radar-Beobachtungen, Chart-Patterns und globale Ereignisse.
RADAR_SUMMARY_ENABLED=false
RADAR_SUMMARY_CRON=0 * * * *
RADAR_SUMMARY_LOOKBACK_MINUTES=60
RADAR_SUMMARY_MIN_EVENT_COUNT=1
RADAR_SUMMARY_WEBHOOK_ENABLED=false

# Global Event Monitor: beobachtet Makro-/Geopolitik-/Markt-News (Finnhub General News),
# speichert strukturierte MarketEvents und sendet optional Research-Alerts über n8n.
# Läuft im worker-scheduler Container auf GLOBAL_EVENT_MONITOR_CRON. Benötigt FINNHUB_API_KEY.
GLOBAL_EVENT_MONITOR_ENABLED=false
GLOBAL_EVENT_MONITOR_CRON=*/30 * * * *
# Kommagetrennt aus: general, forex, crypto, merger
GLOBAL_EVENT_MONITOR_CATEGORIES=general
GLOBAL_EVENT_MONITOR_MAX_EVENTS=25
GLOBAL_EVENT_ALERTS_ENABLED=false
MIN_EVENT_ALERT_SEVERITY=IMPORTANT
# Cooldown pro Ereignistyp (z.B. CONFLICT), damit ähnliche News nicht spammen
GLOBAL_EVENT_ALERT_COOLDOWN_MINUTES=120
GLOBAL_EVENT_MAX_ALERTS_PER_RUN=3

# ─── Alerts ──────────────────────────────────────────────────────────────────
ALERT_MODE=WATCHLIST_ONLY
ALERT_COOLDOWN_MINUTES=240
ALERT_SCORE_IMPROVEMENT_THRESHOLD=8
